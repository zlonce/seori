{$DOMAIN} {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=2592000, immutable"
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
